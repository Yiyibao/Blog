# 口令策略（P0-8）：所有口令/密钥必须随机生成
# - DB_PASSWORD / APP_ADMIN_PASSWORD：至少 16 位随机字符（如 openssl rand -base64 16）
# - APP_JWT_SECRET：至少 32 位随机字符（如 openssl rand -base64 48）
# 注意：占位符值无法通过启动校验（NB-3），照抄本模板不能上线。
DB_URL=jdbc:postgresql://localhost:5432/yubai_blog
DB_USERNAME=yubai_app
DB_PASSWORD=replace_with_your_local_password
SERVER_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_JWT_SECRET=replace_with_at_least_32_random_characters
APP_JWT_TTL=PT2H
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace_with_a_strong_admin_password
# 站长展示名（可选，缺省用用户名）——出现在今日菜单署名与问候语里
APP_ADMIN_DISPLAY_NAME=
# FD-6 伴侣账号（PARTNER 角色，可选）：只建不改——改口令不会更新已存在的账号。
# 口令至少 12 位，建议中文短语（手机好输入且强度高），不得与站长口令相同、不要用生日/纪念日。
APP_PARTNER_USERNAME=
APP_PARTNER_PASSWORD=
APP_PARTNER_DISPLAY_NAME=
# 登录人机验证（L-7，可选覆盖，均有默认值）：
# - APP_AUTH_POW_DIFFICULTY：PoW 难度（SHA-256 前导 '0' 个数），每 +1 前端计算量 ×16，默认 4
# - 失败 ≥APP_AUTH_CAPTCHA_THRESHOLD 次出图形码；同 IP ≥APP_AUTH_COOLDOWN_THRESHOLD 次进入冷却
#APP_AUTH_POW_DIFFICULTY=4
#APP_AUTH_CHALLENGE_TTL=PT5M
#APP_AUTH_CAPTCHA_THRESHOLD=3
#APP_AUTH_COOLDOWN_THRESHOLD=10
#APP_AUTH_FAILURE_WINDOW=PT15M
#APP_AUTH_COOLDOWN_DURATION=PT30M
# 6C-1：本地纯 HTTP 开发设 false；生产 HTTPS 必须保持 true
#APP_JWT_COOKIE_SECURE=false
#APP_JWT_REFRESH_TTL=P7D
#APP_JWT_REFRESH_REMEMBER_TTL=P30D
# 6B：附件存储根目录（本地文件系统；生产搬迁至 nginx/S3 时更换 StorageService 实现即可）
#APP_ATTACHMENT_STORAGE_DIR=./data/attachments
#APP_ATTACHMENT_MAX_TOTAL_BYTES=1073741824
# AI chat (optional — leave unset or false to disable)
# 4A-1 多供应商注册表：
# - APP_AI_MASTER_KEY：供应商 API 密钥的加密主密钥，至少 32 位随机字符（openssl rand -base64 48）。
#   未配置时管理界面无法保存/使用注册表密钥，仅剩下方 AI_* 环境变量回退。
# - APP_AI_ALLOW_LOCAL_ENDPOINTS：允许 base_url 指向本地/私网端点（如 Ollama），默认 false；改动需重启。
APP_AI_MASTER_KEY=
APP_AI_ALLOW_LOCAL_ENDPOINTS=false
AI_ENABLED=false
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
# Native Anthropic Messages API (optional; token must stay out of git)
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODELS=claude-fable-5,claude-haiku-4-5,claude-haiku-4-5-20251001,claude-opus-4-6,claude-opus-4-7,claude-opus-4-8,claude-opus-5,claude-sonnet-4-6,claude-sonnet-5

# OpenAI Responses API relay (server-side only; materialized as an encrypted provider row)
APP_AI_RESPONSES_ENABLED=false
APP_AI_RESPONSES_BASE_URL=https://xinyue.mom
APP_AI_RESPONSES_API_KEY=
APP_AI_RESPONSES_MODEL=gpt-5.5
APP_AI_RESPONSES_MODELS=gpt-5.3-codex-spark,gpt-5.4,gpt-5.5,gpt-5.6-luna,gpt-5.6-sol,gpt-5.6-terra
APP_AI_RESPONSES_HEADER_NAME=x-openai-actor-authorization
APP_AI_RESPONSES_HEADER_VALUE=local-image-extension
APP_AI_RESPONSES_REASONING_EFFORT=xhigh
APP_AI_RESPONSES_STORE=false

AI_REQUEST_TIMEOUT=60
AI_MAX_INPUT_CHARS=32000
AI_MAX_HISTORY_MESSAGES=20
AI_MAX_TOTAL_CHARS=160000
AI_MAX_OUTPUT_TOKENS=2048
# OpenCode Server sidecar (optional — only for OPENCODE_SERVER provider type)
# HTTP Basic credentials for the sidecar's admin API; password is never logged or returned.
APP_AI_OPENCODE_USERNAME=
APP_AI_OPENCODE_PASSWORD=
APP_AI_OPENCODE_AGENT=blog-ai
APP_AI_OPENCODE_PROVIDER_ID=opencode-go

# Website-level AI platform. Production bootstrap enables these after GA approval;
# local/test environments keep the conservative disabled defaults below.
APP_AI_PLATFORM_TASKS_ENABLED=false
APP_AI_PLATFORM_MULTIMODAL_ENABLED=false
APP_AI_PLATFORM_MEMORY_ENABLED=false
APP_AI_PLATFORM_ARTIFACTS_ENABLED=false
#APP_AI_PLATFORM_MAX_FILE_BYTES=15000000
#APP_AI_PLATFORM_MAX_ARTIFACT_BYTES=15000000
#APP_AI_PLATFORM_MAX_OWNER_FILE_BYTES=100000000
#APP_AI_PLATFORM_MAX_OWNER_FILES=100
#APP_AI_PLATFORM_CLEANUP_INTERVAL_MS=3600000
#APP_AI_PLATFORM_MAX_CONCURRENT_TASKS=4
#APP_AI_PLATFORM_MAX_CONCURRENT_TASKS_PER_USER=2
#APP_AI_PLATFORM_MAX_CONCURRENT_TASKS_PER_PROVIDER=2
#APP_AI_PLATFORM_MAX_QUEUED_TASKS=16
#APP_AI_PLATFORM_MAX_MEMORY_CONTEXT_TOKENS=1500
#APP_AI_PLATFORM_MAX_SESSION_SUMMARY_TOKENS=1000
#APP_AI_PLATFORM_MAX_RECENT_MESSAGE_TOKENS=4000
#APP_AI_PLATFORM_MAX_RECENT_MESSAGES=16
#APP_AI_PLATFORM_MAX_SUMMARY_SOURCE_MESSAGES=120

# AI image generation (server-side only; never expose these values to the browser)
AI_IMAGE_ENABLED=false
AI_IMAGE_MAX_PROMPT_CHARS=32000
AI_IMAGE_MAX_IMAGES=1
AI_IMAGE_MAX_BYTES=15000000
AI_IMAGE_REQUEST_TIMEOUT=120
AI_IMAGE_RATE_LIMIT=3
AI_IMAGE_RATE_WINDOW_SECONDS=60
AI_IMAGE_GROK_ENABLED=false
AI_IMAGE_GROK_BASE_URL=https://xinyue.mom/v1
AI_IMAGE_GROK_API_KEY=
AI_IMAGE_GROK_MODELS=grok-imagine-image
AI_IMAGE_GROK_MODEL=grok-imagine-image
AI_IMAGE_GROK_WIRE_API=images
AI_IMAGE_GPT_ENABLED=false
AI_IMAGE_GPT_BASE_URL=https://xinyue.mom
AI_IMAGE_GPT_API_KEY=
AI_IMAGE_GPT_MODELS=gpt-image-2
AI_IMAGE_GPT_MODEL=gpt-image-2
AI_IMAGE_GPT_WIRE_API=images
AI_IMAGE_GPT_HEADER_NAME=x-openai-actor-authorization
AI_IMAGE_GPT_HEADER_VALUE=local-image-extension

# AI 菜谱视频提取（仅下载元数据、字幕和缩略图，不下载完整视频）
APP_RECIPE_VIDEO_ENABLED=true
APP_RECIPE_YT_DLP_PATH=yt-dlp
APP_RECIPE_VIDEO_TIMEOUT=PT45S
APP_RECIPE_MAX_TRANSCRIPT_CHARS=25000
#APP_RECIPE_VIDEO_HOSTS=youtube.com,youtu.be,bilibili.com,b23.tv,douyin.com,iesdouyin.com,xiaohongshu.com,xhslink.com
