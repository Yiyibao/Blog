DB_URL=jdbc:postgresql://localhost:5432/yubai_blog
DB_USERNAME=yubai_app
DB_PASSWORD=replace_with_your_local_password
SERVER_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_JWT_SECRET=replace_with_at_least_32_random_characters
APP_JWT_TTL=PT2H
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace_with_a_strong_admin_password
# AI chat (optional — leave unset or false to disable)
AI_ENABLED=false
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
AI_REQUEST_TIMEOUT=60
AI_MAX_INPUT_CHARS=8000
AI_MAX_HISTORY_MESSAGES=20
AI_MAX_TOTAL_CHARS=40000
AI_MAX_OUTPUT_TOKENS=2048
