{
  "name": "yubai-personal-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && node scripts/clean-build.mjs && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:typecheck": "vue-tsc --noEmit -p tsconfig.vitest.json"
  },
  "dependencies": {
    "@tiptap/extension-code-block-lowlight": "3.28.0",
    "@tiptap/extension-file-handler": "^3.28.0",
    "@tiptap/extension-image": "^3.28.0",
    "@tiptap/extension-list": "^3.28.0",
    "@tiptap/extension-mathematics": "^3.28.0",
    "@tiptap/extension-table": "^3.28.0",
    "@tiptap/extensions": "^3.28.0",
    "@tiptap/markdown": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@tiptap/vue-3": "^3.28.0",
    "axios": "1.18.1",
    "dompurify": "^3.2.7",
    "katex": "^0.17.0",
    "lowlight": "3.3.0",
    "pinia": "3.0.3",
    "vue": "3.5.22",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vue-tsc": "3.1.1"
  }
}
