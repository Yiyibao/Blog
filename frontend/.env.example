# API base URL for backend requests.
# Required. Default: /api/v1
VITE_API_BASE_URL=/api/v1

# Allow bundled content fallback when backend is unreachable.
# Optional. Default: unset (only enabled in dev)
VITE_ALLOW_BUNDLED_CONTENT=

# AI Workspace feature gate. Local/test environments may keep this false;
# the production deploy workflow explicitly builds with it enabled.
VITE_AI_PLATFORM_ENABLED=false

# ── Site public configuration ──────────────────────────────────────────────
# These values are consumed through src/config/site.ts and shared by SEO
# features, page meta, sitemap, Open Graph, and footer.

# Site name. Required. Default: 日常拾光录
VITE_SITE_NAME=日常拾光录

# Site subtitle. Optional. Default: hxnf's Memoir.
VITE_SITE_SUBTITLE=hxnf's Memoir.

# Site description. Required.
VITE_SITE_DESCRIPTION=拾起代码、阅读、料理与日常生活里的微光，记录思考，也珍藏时间。

# Public site root URL with protocol. Required for canonical links.
# No trailing slash. Source dev default: http://localhost:5173; build snapshots
# default to the deployed site https://hxnf.top when this variable is not exported.
VITE_SITE_URL=http://localhost:5173

# Default social sharing image path. Optional. Default: /og.png
VITE_SOCIAL_IMAGE=/og.png

# Display name of the site author. Required. Default: hxnf
VITE_AUTHOR_NAME=hxnf

# Copyright owner text. Optional. Default: (empty — falls back to site name)
VITE_COPYRIGHT_OWNER=

# Copyright start year. Optional. Default: current year
VITE_COPYRIGHT_YEAR=

# Public contact email. Optional. Default: (empty)
VITE_CONTACT_EMAIL=

# ICP record number (China). Production default: 苏ICP备2026052529号-1
VITE_ICP_RECORD=苏ICP备2026052529号-1

# ICP record link. Optional. Default: https://beian.miit.gov.cn/
VITE_ICP_LINK=https://beian.miit.gov.cn/

# Public security record number (China). Optional. Default: (empty)
VITE_POLICE_RECORD=

# Public security record link. Optional. Default: (empty)
VITE_POLICE_LINK=

# ── Build-time SEO prerendering ────────────────────────────────────────────
# If set, `node scripts/prerender-seo.mjs` fetches public API data at this
# URL and generates HTML snapshots for dynamic routes (/articles/:slug,
# /series/:slug, /tags/:tag). The value must be the full base URL of the
# backend API, e.g. https://hxnf.top/api/v1 or http://localhost:8080/api/v1.
# Optional. When unset only static/public routes are prerendered.
PRERENDER_API_BASE_URL=
