# P0-3 双保险：登录接口按客户端 IP 限速（应用层另有限流）
limit_req_zone $binary_remote_addr zone=login_limit:10m rate=5r/m;
# L-7：登录 challenge 接口限速（重试 + 换一张需要比登录更宽的额度，应用层另有 15 次/分限流）
limit_req_zone $binary_remote_addr zone=challenge_limit:10m rate=15r/m;
# FD-1：/api/ 全局兜底限速——应用层限流是进程内固定窗口（重启即失效），nginx 层补第二道防线；
# burst 120 nodelay 吸收 SPA 页面加载的并发突发，持续超 60r/m 才拒绝
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=60r/m;

server {
    listen 80;
    listen [::]:80;

    server_name hxnf.top www.hxnf.top;

    return 301 https://hxnf.top$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name hxnf.top www.hxnf.top;

    ssl_certificate /etc/nginx/ssl/hxnf.top/fullchain.crt;
    ssl_certificate_key /etc/nginx/ssl/hxnf.top/private.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        application/json
        application/javascript
        application/xml
        application/manifest+json
        image/svg+xml;

    root /opt/yubai-blog/current/frontend/client;
    index index.html;
    client_max_body_size 9m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # P0-10：HSTS（全站已强制 HTTPS）
    add_header Strict-Transport-Security "max-age=31536000" always;

    # P0-3：登录接口限速（5 次/分钟/IP，burst 5 立即拒绝）
    location = /api/v1/auth/login {
        limit_req zone=login_limit burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # L-7：challenge 获取限速（15 次/分钟/IP，burst 10 应对正常重试）
    location = /api/v1/auth/challenge {
        limit_req zone=challenge_limit burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # FD-1：kitchen（今日菜单/打卡）为纯 JSON 小请求体，收紧上限防滥用
    location /api/v1/kitchen/ {
        limit_req zone=api_limit burst=120 nodelay;
        limit_req_status 429;
        client_max_body_size 128k;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location /api/ {
        limit_req zone=api_limit burst=120 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location /actuator/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Public assets with stable names may change between releases, so keep a
    # shorter browser cache than Vite's content-hashed /assets/ files.
    location ~* ^/(images|food|icons)/ {
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public";
    }

    # The app shell and service worker must revalidate so a deployment becomes
    # visible immediately instead of being held behind a stale browser cache.
    location = /index.html {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
    }

    location = /sw.js {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
    }

    location ~* \.map$ {
        return 404;
    }

    # ND-1：sitemap 与 robots 由后端生成，必须显式转发，
    # 否则落入 SPA fallback 返回 index.html，整套 SEO 输出线上不可达。
    location = /sitemap.xml {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location = /rss.xml {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location = /robots.txt {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
