#!/usr/bin/env bash
set -euo pipefail

BACKUP_DIR="/var/backups/yubai-blog"
STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
TARGET="${BACKUP_DIR}/yubai_blog-${STAMP}.dump"
TEMP_TARGET="${TARGET}.tmp"
ATTACHMENT_DIR="${APP_ATTACHMENT_STORAGE_DIR:-/opt/yubai-blog/data/attachments}"
ATTACHMENT_TARGET="${BACKUP_DIR}/attachments-${STAMP}.tar.gz"
TEMP_ATTACHMENT_TARGET="${ATTACHMENT_TARGET}.tmp"
MANIFEST="${BACKUP_DIR}/SHA256SUMS-${STAMP}"
TEMP_MANIFEST="${MANIFEST}.tmp"
BACKUP_FILES=("${TARGET}")

install -d -o postgres -g postgres -m 0700 "${BACKUP_DIR}"
sudo -u postgres pg_dump --format=custom --file="${TEMP_TARGET}" yubai_blog
chown postgres:postgres "${TEMP_TARGET}"
chmod 0600 "${TEMP_TARGET}"
mv "${TEMP_TARGET}" "${TARGET}"

[[ -d "${ATTACHMENT_DIR}" ]] || {
    echo "Attachment directory does not exist: ${ATTACHMENT_DIR}" >&2
    exit 1
}

tar --create --gzip --file="${TEMP_ATTACHMENT_TARGET}" --directory="${ATTACHMENT_DIR}" .
chown postgres:postgres "${TEMP_ATTACHMENT_TARGET}"
chmod 0600 "${TEMP_ATTACHMENT_TARGET}"
mv "${TEMP_ATTACHMENT_TARGET}" "${ATTACHMENT_TARGET}"
BACKUP_FILES+=("${ATTACHMENT_TARGET}")

(
    cd "${BACKUP_DIR}"
    sha256sum "${BACKUP_FILES[@]##*/}" > "${TEMP_MANIFEST##*/}"
)
chown postgres:postgres "${TEMP_MANIFEST}"
chmod 0600 "${TEMP_MANIFEST}"
mv "${TEMP_MANIFEST}" "${MANIFEST}"

if [[ "${COS_BACKUP_ENABLED:-false}" == "true" ]]; then
    : "${COS_BUCKET_ALIAS:?COS_BUCKET_ALIAS is required when COS backup is enabled}"
    command -v coscli >/dev/null

    COSCLI_CONFIG_PATH="${COSCLI_CONFIG_PATH:-/etc/yubai-blog/cos.yaml}"
    COS_BACKUP_PREFIX="${COS_BACKUP_PREFIX:-backups/prod}"
    COS_BACKUP_PREFIX="${COS_BACKUP_PREFIX#/}"
    COS_BACKUP_PREFIX="${COS_BACKUP_PREFIX%/}"
    COS_DESTINATION="cos://${COS_BUCKET_ALIAS}/${COS_BACKUP_PREFIX}/${STAMP}"

    [[ -r "${COSCLI_CONFIG_PATH}" ]] || {
        echo "COSCLI config is not readable: ${COSCLI_CONFIG_PATH}" >&2
        exit 1
    }

    for file in "${BACKUP_FILES[@]}" "${MANIFEST}"; do
        coscli --config-path "${COSCLI_CONFIG_PATH}" \
            cp "${file}" "${COS_DESTINATION}/${file##*/}" \
            --forbid-overwrite=true \
            --encryption-type SSE-COS \
            --server-side-encryption AES256
    done
fi

find "${BACKUP_DIR}" -maxdepth 1 -type f \
    \( -name 'yubai_blog-*.dump' -o -name 'attachments-*.tar.gz' -o -name 'SHA256SUMS-*' \) \
    -mtime +14 -delete
