[Unit]
Description=Back up the Yubai Blog PostgreSQL database
After=postgresql.service network-online.target
Requires=postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/yubai-blog/backup.env
ExecStart=/usr/local/sbin/yubai-blog-backup
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
