# Install as /etc/yubai-blog/backup.env with mode 0640 and owner root:yubai.
APP_ATTACHMENT_STORAGE_DIR=/opt/yubai-blog/shared/attachments

# COSCLI owns the SecretId/SecretKey in its root-only config file. Never put them here.
# Enable only after manual upload, download, hash, and restore verification succeed.
COS_BACKUP_ENABLED=false
COSCLI_CONFIG_PATH=/etc/yubai-blog/cos.yaml
COS_BUCKET_ALIAS=backup
COS_BACKUP_PREFIX=backups/prod
